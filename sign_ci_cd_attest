Updating the Pipeline (sign and test)
-------------------
cat >.gitlab-ci.yml <<'EOF'
stages:
  - sbom
  - attest
  - sign

generate-sbom:
  stage: sbom
  image: docker:stable-dind
  before_script:
    - apk add --no-cache curl
    - curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin v1.37.0
  script:
    - syft scan dir:. --source-name cmcp-expenseapprover --source-version 1.0.0 -o spdx-json=sbom.spdx.json
  artifacts:
    paths:
      - sbom.spdx.json
    when: always

build-attestation:
  stage: attest
  image: alpine:latest
  before_script:
    - apk add --no-cache jq coreutils git
  script:
    - COMMIT_HASH=$(git rev-parse HEAD)
    - SBOM_FILE="sbom.spdx.json"
    - SBOM_SHA256=$(sha256sum "$SBOM_FILE" | awk '{print $1}')
    - "jq -n --arg c \"$COMMIT_HASH\" --arg f \"$SBOM_FILE\" --arg h \"$SBOM_SHA256\" '{commit: $c, sbom_file: $f, sbom_sha256: $h}' > attestation.json"
    - cat attestation.json
  artifacts:
    paths:
      - attestation.json
      - sbom.spdx.json
    when: always

sign-attestation:
  stage: sign
  image: alpine:latest
  before_script:
    - apk add --no-cache wget
    - wget -q "https://github.com/sigstore/cosign/releases/download/v2.6.1/cosign-linux-amd64"
    - mv cosign-linux-amd64 /usr/local/bin/cosign
    - chmod +x /usr/local/bin/cosign
  script:
    - cp "$COSIGN_PRIVATE_KEY" cosign.key
    - cosign sign-blob attestation.json --key cosign.key --output-signature attestation.json.sig --tlog-upload=false --yes
  variables:
    COSIGN_PASSWORD: "$COSIGN_PASSWORD"
  artifacts:
    paths:
      - attestation.json
      - attestation.json.sig
      - sbom.spdx.json
    when: always
EOF

