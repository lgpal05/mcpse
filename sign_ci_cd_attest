Adding the generate-sbom Job
------------
cat >.gitlab-ci.yml <<'EOF'
stages:
  - sbom
  - attest
  - sign

generate-sbom:
  stage: sbom
  image: docker:stable-dind
  before_script:
    - apk add --no-cache curl
    - curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin v1.37.0
  script:
    - syft scan dir:. --source-name cmcp-expenseapprover --source-version 1.0.0 -o spdx-json=sbom.spdx.json
  artifacts:
    paths:
      - sbom.spdx.json
    when: always

build-attestation:
  stage: attest
  script:
    - echo "This is the build-attestation job"

sign-attestation:
  stage: sign
  script:
    - echo "This is the sign-attestation job"
EOF

