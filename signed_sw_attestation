Creating the Attestation File
---------------
COMMIT_HASH=$(git rev-parse HEAD)

SBOM_SHA256=$(sha256sum "$SBOM_FILE" | awk '{print $1}')

jq -n \
  --arg c "$COMMIT_HASH" \
  --arg f "$SBOM_FILE" \
  --arg h "$SBOM_SHA256" \
  '{commit: $c, sbom_file: $f, sbom_sha256: $h}' > attestation.json

  cat attestation.json

  Downloading and Installing Cosign
--------------------------
cosign generate-key-pair

sigining the attestation
---------
cosign sign-blob attestation.json --key cosign.key --output attestation.json.sig

cosign verify-blob attestation.json --signature attestation.json.sig --key cosign.pub

